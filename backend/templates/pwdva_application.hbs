<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body { font-family: Arial, sans-serif; color: #111; }
      .wrap { padding: 24px; }
      .header {
        text-align: center;
        border: 2px solid #4f46e5;
        border-radius: 14px;
        padding: 16px 18px;
      }
      .title { font-size: 22px; font-weight: 800; letter-spacing: 0.2px; }
      .subtitle { margin-top: 6px; font-size: 13px; color: #4b5563; }
      .meta { margin-top: 18px; display:grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .meta .box { border: 1px solid #e5e7eb; border-radius: 10px; padding: 12px; }
      .meta b { display:block; margin-bottom: 4px; }
      .section { margin-top: 18px; line-height: 1.6; font-size: 14px; }
      .label { font-weight: 800; }
      .hr { height:1px; background:#e5e7eb; margin: 18px 0; }
      .list { margin: 8px 0 0 18px; }
      .list li { margin: 4px 0; }
      .sign { margin-top: 26px; display:flex; gap: 24px; }
      .sign .col { flex: 1; }
      .sign .label { font-size: 12px; color: #6b7280; margin-bottom: 6px; font-weight: normal; }
      .footer { margin-top: 26px; font-size: 12px; color:#6b7280; }
      .pre { white-space: pre-wrap; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="header">
        <div class="title">PWDVA 2005 - Form I</div>
        <div class="subtitle">Protection of Women from Domestic Violence Act, 2005</div>
      </div>

      <div class="meta">
        <div class="box">
          <b>Date</b>
          {{date}}
        </div>
        <div class="box">
          <b>District / Court</b>
          {{district}} - {{court_name}}
        </div>
      </div>

      <div class="section">
        <p><span class="label">Applicant (Aggrieved Person):</span></p>
        <p>
          {{applicant_name}}<br/>
          {{applicant_address}}
        </p>

        <div class="hr"></div>

        <p><span class="label">Respondent (Respondent/Aggrieved Person):</span></p>
        <p>
          {{respondent_name}}<br/>
          {{respondent_address}}
        </p>
        {{#if relationship}}
          <p style="margin-top: 10px;"><span class="label">Relationship:</span> {{relationship}}</p>
        {{/if}}

        <div class="hr"></div>

        <p><span class="label">Incident Description:</span></p>
        <div class="pre">{{incident_description}}</div>

        <div class="hr"></div>

        <p><span class="label">Reliefs Sought:</span></p>
        {{#if reliefs_sought.length}}
          <ul class="list">
            {{#each reliefs_sought}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{else}}
          <div>No reliefs selected.</div>
        {{/if}}

        {{#if children_details}}
          <div class="hr"></div>
          <p><span class="label">Children Details (if any):</span></p>
          <div class="pre">{{children_details}}</div>
        {{/if}}

        <div class="sign">
          <div class="col">
            <div class="label">Applicant Signature</div>
            <div style="margin-top: 18px; border-bottom: 1px solid #111; height: 34px;"></div>
          </div>
          <div class="col">
            <div class="label">Name</div>
            <div style="margin-top: 18px; font-weight: 700;">{{applicant_name}}</div>
          </div>
        </div>
      </div>

      <div class="footer">
        This document is generated to assist with drafting and should be reviewed before filing.
      </div>
    </div>
  </body>
</html>

