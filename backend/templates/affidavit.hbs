<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body { font-family: Georgia, "Times New Roman", Times, serif; font-size: 12pt; line-height: 1.4; text-align: justify; color: #111; }
      h1 { font-size: 16pt; text-align: center; margin: 0 0 12pt; }
      .watermark {
        position: fixed;
        top: 45%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-30deg);
        font-size: 64pt;
        font-weight: 700;
        color: rgba(0,0,0,0.06);
        letter-spacing: 2px;
        white-space: nowrap;
        pointer-events: none;
        z-index: -1;
      }
      .footer {
        position: fixed;
        bottom: 1cm;
        left: 0;
        right: 0;
        text-align: center;
        font-size: 10pt;
        color: #333;
      }
      .section { margin-bottom: 10pt; }
      ol { padding-left: 1.3cm; }
      li { margin-bottom: 8pt; }
      .sig { margin-top: 22pt; display:flex; justify-content: space-between; }
    </style>
  </head>
  <body>
    <div class="watermark">CONFIDENTIAL</div>
    <h1>AFFIDAVIT</h1>

    <div class="section">
      I, {{deponent_name}}, aged {{deponent_age}} years, residing at {{deponent_address}}, do hereby solemnly affirm and state as follows:
      <br/><br/>
      Date: {{date}}
      <br/>
      Place/City: {{city}}
    </div>

    <ol>
      <li>
        <b>Statement.</b> I state that {{statement_text}}
      </li>
      <li>
        <b>Verification.</b> I verify that the contents of this affidavit are true and correct to the best of my knowledge and belief.
      </li>
      <li>
        <b>Legal validity.</b> This affidavit is executed for legal purposes under applicable Indian law.
      </li>
    </ol>

    <div class="sig">
      <div>
        <div style="font-weight: 600;">Deponent</div>
        <div style="margin-top: 36pt;">{{deponent_name}}</div>
      </div>
      <div style="text-align:right;">
        <div style="font-weight: 600;">Notary/Attesting Authority</div>
        <div style="margin-top: 36pt;">{{notary_name}}</div>
      </div>
    </div>

    <div class="footer">This document is generated by NextGenLegal and is legally valid under Indian law</div>
  </body>
</html>

